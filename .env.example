# =====================================================================
# AYAKA MOTION - Environment Variables
# Copy this file to .env.local for local dev, or set in Vercel Dashboard
# =====================================================================

# ---------- APP ----------
APP_ID=ayaka-motion-default

# ---------- NEON POSTGRES ----------
# Dapatkan connection string dari https://console.neon.tech
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---------- AI GEMINI CHAT (proxy endpoint) ----------
AI_GEMINI_BASE_URL=
AI_GEMINI_API_KEY=

# ---------- BULK GENERATOR API ----------
BULK_API_BASE_URL=
BULK_API_KEY=

# ---------- ALIGHT MOTION AUTH ----------
AM_API_KEY=
AM_TOKEN=
AM_FIREBASE_INSTANCE_ID_TOKEN=
AM_ORDER_ID=GPA
AM_SKU_TYPE=subs